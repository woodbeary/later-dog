{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laterdog-supervisor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "containers": [
    {
      "class_name": "SupervisorHost",
      "image": "registry.cloudflare.com/da1336ec3e3f7d9a4971022ae074c5d7/laterdog-supervisor-options@sha256:4e3fff20d758276f3acf70dfd13f1e7226fcc2b60009a2269001d2cb34b5d42e",
      "instance_type": "standard-3",
      "max_instances": 1,
      "observability": { "enabled": true }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SUPERVISOR", "class_name": "SupervisorHost" }]
  },
  "exports": {
    "SupervisorHost": { "type": "durable-object", "storage": "sqlite" }
  },
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "laterdog-state" }],
  "services": [{ "binding": "COMPUTERS", "service": "laterdog-computers", "entrypoint": "ComputersApi" }],
  "vars": { "LATERDOG_WORKSPACE_URL": "", "TRACE_RETENTION_DAYS": "30" }
}
