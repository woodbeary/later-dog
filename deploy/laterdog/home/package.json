{
  "name": "laterdog-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker and Containers that host each person's later.dog Cloud home.",
  "scripts": {
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "dry-run": "wrangler deploy --dry-run --containers-rollout=none",
    "deploy": "wrangler deploy",
    "preinstall": "node scripts/check-package-manager.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.148.0"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24",
    "bun": "1.4.5"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
