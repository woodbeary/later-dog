{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Laterdog-Client-Ip
	}
}

:8080 {
	encode zstd gzip

	handle /api/health {
		reverse_proxy 127.0.0.1:8799 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {client_ip}
		}
	}

	@home host {$LATERDOG_CLOUD_PUBLIC_HOST}
	handle @home {
		handle /hooks/* {
			reverse_proxy 127.0.0.1:8800 {
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-For {client_ip}
			}
		}
		handle {
			reverse_proxy 127.0.0.1:8799 {
				header_up X-Forwarded-Proto https
				header_up X-Forwarded-For {client_ip}
				flush_interval -1
			}
		}
	}

	handle {
		respond 403
	}
}
