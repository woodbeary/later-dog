{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laterdog-home",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "routes": [
    {
      "pattern": "*-home.later.dog/*",
      "zone_name": "later.dog"
    }
  ],
  "containers": [
    {
      "class_name": "CloudHomeHost",
      "image": "registry.cloudflare.com/da1336ec3e3f7d9a4971022ae074c5d7/laterdog-home-cloudhomehost@sha256:f45ba413ad8bfee9cdb601c1b3bc968f4b6a63ebc782a6266b06bc26f90dde8e",
      "instance_type": "standard-1",
      "max_instances": 400,
      "observability": {
        "enabled": true
      }
    },
    {
      "class_name": "CloudHomeHostLarge",
      "image": "registry.cloudflare.com/da1336ec3e3f7d9a4971022ae074c5d7/laterdog-home-cloudhomehostlarge@sha256:e64ff59e579d590b4bb4df7045ea58575805137be9eb5db963a732fa51d5de42",
      "instance_type": "standard-4",
      "max_instances": 10,
      "observability": {
        "enabled": true
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOMES",
        "class_name": "CloudHomeHost"
      },
      {
        "name": "HOMES_LARGE",
        "class_name": "CloudHomeHostLarge"
      }
    ]
  },
  "exports": {
    "CloudHomeHost": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CloudHomeHostLarge": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "STATE",
      "bucket_name": "laterdog-homes"
    }
  ],
  "services": [
    {
      "binding": "COMPUTERS",
      "service": "laterdog-computers",
      "entrypoint": "ComputersApi"
    },
    {
      "binding": "ACCOUNTS",
      "service": "laterdog-control-plane",
      "entrypoint": "AccountsApi"
    }
  ],
  "vars": {
    "HOME_HOST_SUFFIX": "-home.later.dog",
    "ADMIN_ORIGIN": "https://accounts.later.dog",
    "INCLUDED_API": "https://cloud.later.dog/v1",
    "LARGE_HOME_ACCOUNTS": "7eaec07f-4e74-4682-81c2-d3bf10549606",
    "ALWAYS_ON_ACCOUNTS": "7eaec07f-4e74-4682-81c2-d3bf10549606",
    "HOME_SLEEP_AFTER": "",
    "HOME_WAKE_GUARD": "learning",
    "DEV_CODE": "7eaec07f-4e74-4682-81c2-d3bf10549606"
  },
  "secrets": {
    "required": [
      "HOME_SECRET"
    ]
  },
  "account_id": "da1336ec3e3f7d9a4971022ae074c5d7"
}
