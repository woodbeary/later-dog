{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laterdog-computers",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "cloud.later.dog", "custom_domain": true }],
  "containers": [
    {
      // One container per DogComputer Durable Object. With this policy the Durable Object picks the image (or a snapshot)
      // and the instance size each time it starts its computer; see src/computer.ts.
      "class_name": "DogComputer",
      "scheduling_policy": "durable_object",
      "images": {
        "desktop": { "dockerfile": "./container/Dockerfile", "build_context": "./container" }
      },
      "observability": { "enabled": true }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COMPUTER", "class_name": "DogComputer" },
      { "name": "REGISTRY", "class_name": "ComputerRegistry" },
      { "name": "TRIALS", "class_name": "TrialRegistry" }
    ]
  },
  "ratelimits": [
    { "name": "TRIAL_FORM_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "TRIAL_API_LIMIT", "namespace_id": "4102", "simple": { "limit": 300, "period": 60 } },
    { "name": "INCLUDED_LIMIT", "namespace_id": "4103", "simple": { "limit": 60, "period": 60 } }
  ],
  "ai": { "binding": "AI", "remote": true },
  "exports": {
    "DogComputer": { "type": "durable-object", "storage": "sqlite" },
    "ComputerRegistry": { "type": "durable-object", "storage": "sqlite" },
    "TrialRegistry": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    // How many computers may exist at once, awake or asleep.
    "MAX_COMPUTERS": "10",
    // An awake computer with no API calls and no open viewer for this long is snapshotted and stopped.
    "IDLE_SLEEP_MINUTES": "15",
    // Backstop: any computer awake this long is snapshotted and stopped, even with a viewer open.
    "MAX_AWAKE_HOURS": "8",
    "TRIALS_ENABLED": "true",
    "TRIAL_MINUTES": "30",
    "TRIAL_DAYS": "7",
    "TRIALS_PER_DAY": "100",
    "TRIAL_IDLE_SLEEP_MINUTES": "5",
    "TRIAL_COUNTRIES": "",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFToUIA2DvjWJrmf",
    // AI Gateway for included decisions (Workers AI Clef) and voice (ElevenLabs, its key stored in the gateway).
    "AI_GATEWAY_ID": "default",
    // later.dog Cloud, $10/month through Square (location "later.dog", plan "later.dog Cloud").
    "SQUARE_API_VERSION": "2026-05-20",
    "SQUARE_LOCATION_ID": "L7GC619QNDQ55",
    "SQUARE_PLAN_VARIATION_ID": "H7QYVJZLBX4NCKAP6LT7HQDA",
    "PLAN_PRICE_CENTS": "1000",
    // Cloud computer hours each paid month, and the days a lapsed payment keeps working.
    "PLAN_HOURS": "40",
    "PLAN_GRACE_DAYS": "3"
  }
  // Secrets (wrangler secret put, values piped on stdin):
  // COMPUTERS_KEY_SHA256 - lowercase hex SHA-256 of the API key ("ldc_..."); the key itself is never stored here.
  // DESKTOP_SIGNING_KEY  - random HMAC key for signed desktop viewer links.
  // ELEVENLABS_API_KEY   - restricted ElevenLabs key for included voice (Text to Speech + Voices read).
  // XAI_API_KEY          - xAI key for later.dog AI, the free trial's included model.
  // SQUARE_ACCESS_TOKEN  - Square production access token for the later.dog Cloud plan.
}
