{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laterdog-computers",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../../../third_party/novnc/public" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cloud.later.dog", "custom_domain": true }],
  "containers": [
    {
      "class_name": "DogComputer",
      "scheduling_policy": "durable_object",
      "images": {
        "desktop": { "image": "registry.cloudflare.com/da1336ec3e3f7d9a4971022ae074c5d7/laterdog-computers-dogcomputer-desktop@sha256:4b84bac6db3e5c4352521c623036fa01415fcb6b0530b34243f7f1d5c4f46ff7" }
      },
      "observability": { "enabled": true }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COMPUTER", "class_name": "DogComputer" },
      { "name": "REGISTRY", "class_name": "ComputerRegistry" },
      { "name": "TRIALS", "class_name": "TrialRegistry" }
    ]
  },
  "ratelimits": [
    { "name": "TRIAL_FORM_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "TRIAL_API_LIMIT", "namespace_id": "4102", "simple": { "limit": 300, "period": 60 } },
    { "name": "INCLUDED_LIMIT", "namespace_id": "4103", "simple": { "limit": 60, "period": 60 } }
  ],
  "ai": { "binding": "AI", "remote": true },
  "exports": {
    "DogComputer": { "type": "durable-object", "storage": "sqlite" },
    "ComputerRegistry": { "type": "durable-object", "storage": "sqlite" },
    "TrialRegistry": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "IDLE_SLEEP_MINUTES": "10",
    "MAX_AWAKE_HOURS": "8",
    "TRIALS_ENABLED": "true",
    "TRIAL_MINUTES": "30",
    "TRIAL_DAYS": "7",
    "TRIALS_PER_DAY": "100",
    "TRIALS_PER_NETWORK": "2",
    "TRIAL_IDLE_SLEEP_MINUTES": "5",
    "TRIAL_COUNTRIES": "",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFToUIA2DvjWJrmf",
    "AI_GATEWAY_ID": "default",
    "TRIAL_AI_WORKERS_MODEL": "@cf/moonshotai/kimi-k2.6",
    "TRIAL_AI_FIRST": "workers-ai",
    "ANTHROPIC_FIRST": "0",
    "ANTHROPIC_TOKENS_PER_DAY": "40000000",
    "TYPING_AI_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "ELEVENLABS_MODE": "off",
    "ELEVENLABS_CHARS_PER_DAY": "0",
    "ELEVENLABS_PLAN_CHARS_PER_DAY": "1000",
    "TRANSCRIBE_AI_MODEL": "@cf/deepgram/nova-3",
    "SQUARE_API_VERSION": "2026-05-20",
    "SQUARE_LOCATION_ID": "L7GC619QNDQ55",
    "SQUARE_PLAN_VARIATION_ID": "H7QYVJZLBX4NCKAP6LT7HQDA",
    "PLAN_PRICE_CENTS": "1000",
    "PLAN_HOURS": "40",
    "PLAN_GRACE_DAYS": "3"
  }
}
