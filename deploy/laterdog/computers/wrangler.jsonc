{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laterdog-computers",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../../../third_party/novnc/public" },
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false } },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cloud.later.dog", "custom_domain": true }],
  "containers": [
    {
      "class_name": "DogComputer",
      "scheduling_policy": "durable_object",
      "images": {
        "desktop": { "image": "registry.cloudflare.com/da1336ec3e3f7d9a4971022ae074c5d7/laterdog-computers-dogcomputer-desktop@sha256:6c9a67f6e9c0f00b3237cba334c6aea633715b414787dce5bbc616514b6dc7a3" },
        "task": { "image": "registry.cloudflare.com/da1336ec3e3f7d9a4971022ae074c5d7/laterdog-computers-pool@sha256:65d6513b9a24cf7ec4f36bdc8fd5f213e472bc1805e430b0e236c7b544d185cb" }
      },
      "observability": { "enabled": true }
    },
    {
      "class_name": "PoolHost",
      "scheduling_policy": "durable_object",
      "images": {
        "pool": { "image": "registry.cloudflare.com/da1336ec3e3f7d9a4971022ae074c5d7/laterdog-computers-pool@sha256:65d6513b9a24cf7ec4f36bdc8fd5f213e472bc1805e430b0e236c7b544d185cb" }
      },
      "observability": { "enabled": true }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COMPUTER", "class_name": "DogComputer" },
      { "name": "REGISTRY", "class_name": "ComputerRegistry" },
      { "name": "TRIALS", "class_name": "TrialRegistry" },
      { "name": "TASK_LINE", "class_name": "TaskLine" },
      { "name": "POOL_LINE", "class_name": "PoolLine" },
      { "name": "POOL_HOST", "class_name": "PoolHost" }
    ]
  },
  "ratelimits": [
    { "name": "TRIAL_FORM_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "TRIAL_API_LIMIT", "namespace_id": "4102", "simple": { "limit": 300, "period": 60 } },
    { "name": "INCLUDED_LIMIT", "namespace_id": "4103", "simple": { "limit": 60, "period": 60 } }
  ],
  "ai": { "binding": "AI", "remote": true },
  "exports": {
    "DogComputer": { "type": "durable-object", "storage": "sqlite" },
    "ComputerRegistry": { "type": "durable-object", "storage": "sqlite" },
    "TrialRegistry": { "type": "durable-object", "storage": "sqlite" },
    "TaskLine": { "type": "durable-object", "storage": "sqlite" },
    "PoolLine": { "type": "durable-object", "storage": "sqlite" },
    "PoolHost": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "IDLE_SLEEP_MINUTES": "10",
    "MAX_AWAKE_HOURS": "8",
    "TASK_MACHINES_MAX": "100",
    "POOL_HOSTS_MAX": "10",
    "TRIALS_ENABLED": "true",
    "TRIAL_MINUTES": "30",
    "TRIAL_DAYS": "7",
    "TRIALS_PER_DAY": "100",
    "TRIALS_PER_NETWORK": "2",
    "TRIAL_IDLE_SLEEP_MINUTES": "5",
    "TRIAL_COUNTRIES": "",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFToUIA2DvjWJrmf",
    "AI_GATEWAY_ID": "laterdog",
    "TRIAL_AI_WORKERS_MODEL": "@cf/moonshotai/kimi-k2.6",
    "TRIAL_AI_FIRST": "workers-ai",
    "ANTHROPIC_FIRST": "0",
    "ANTHROPIC_TOKENS_PER_DAY": "40000000",
    "TYPING_AI_MODEL": "@cf/meta/llama-3.2-3b-instruct",
    "ELEVENLABS_MODE": "off",
    "ELEVENLABS_CHARS_PER_DAY": "0",
    "ELEVENLABS_PLAN_CHARS_PER_DAY": "1000",
    "TRANSCRIBE_AI_MODEL": "@cf/deepgram/nova-3",
    "TRANSCRIBE_ENGINE": "elevenlabs",
    "SQUARE_API_VERSION": "2026-05-20",
    "SQUARE_LOCATION_ID": "L7GC619QNDQ55",
    "SQUARE_PLAN_VARIATION_ID": "H7QYVJZLBX4NCKAP6LT7HQDA",
    "PLAN_PRICE_CENTS": "1000",
    "PLAN_HOURS": "40",
    "PLAN_GRACE_DAYS": "3"
  }
}
