{
  "phase": "http_request_firewall_managed",
  "logModeHours": 48,
  "rules": [
    {
      "ref": "managed-site",
      "description": "Cloudflare Managed Ruleset with its own actions (block) on the marketing site",
      "expression": "(http.host in {\"later.dog\" \"www.later.dog\"})",
      "action": "execute",
      "action_parameters": {
        "id": "efb7b8c949ac4650a09736fc376e9aee"
      },
      "enabled": true
    },
    {
      "ref": "managed-apps",
      "description": "Cloudflare Managed Ruleset in log mode on accounts, cloud and homes; drop the override after 48 h without false positives",
      "expression": "(http.host in {\"accounts.later.dog\" \"cloud.later.dog\"} or http.host wildcard \"*-home.later.dog\")",
      "action": "execute",
      "action_parameters": {
        "id": "efb7b8c949ac4650a09736fc376e9aee",
        "overrides": {
          "action": "log"
        }
      },
      "enabled": true
    }
  ]
}
