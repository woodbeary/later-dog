# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=laterdog
LATERDOG_BIND_ADDRESS=127.0.0.1
LATERDOG_HTTP_PORT=8080
# Leave empty to use http://localhost:${LATERDOG_HTTP_PORT:-8080}.
LATERDOG_PUBLIC_URL=
# Leave empty to inherit LATERDOG_PUBLIC_URL.
LATERDOG_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set LATERDOG_PUBLIC_URL to https:// followed by the same hostname.
# Requires LATERDOG_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
LATERDOG_HTTPS_HOST=
LATERDOG_BASE_IMAGE=ghcr.io/woodbeary/later-dog:latest
LATERDOG_LOCAL_IMAGE=laterdog-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
LATERDOG_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
LATERDOG_DATA_EXTERNAL=false
