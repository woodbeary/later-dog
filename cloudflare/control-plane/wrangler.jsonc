{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "laterdog-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "accounts.later.dog",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://accounts.later.dog",
    "EMAIL_FROM": "noreply@later.dog",
    "REVIEW_EMAIL": "appreview@later.dog",
    "PHONE_APP_URL": "",
    "ALLOWED_ORIGINS": "",
    "CLOUDFLARE_ACCOUNT_ID": "",
    "CLOUDFLARE_ZONE_ID": "",
    "COMPANION_HOST_SUFFIX": "later.dog",
    "LATERDOG_TUNNEL_LIMIT": "1000",
    "LATERDOG_DNS_RECORD_LIMIT": "1000",
    "LATERDOG_TUNNEL_RECLAIM": "on",
    "LATERDOG_TUNNEL_OFFLINE_RECLAIM_DAYS": "14",
    "LATERDOG_CLEANUP_SWEEP_LIMIT": "4",
    "CLOUD_HOME_CAP": "200",
    "CLOUD_HOME_UNUSED_DAYS": "7",
    "NEW_EMAIL_CODES_PER_DAY": "200",
    "UNVERIFIED_NEW_EMAIL_CODES_PER_DAY": "100",
    "TURNSTILE_SITE_KEY": "",
    "MANAGED_ENDPOINTS": "off"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "CLOUDFLARE_API_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "laterdog-control-plane",
      "database_id": "<your-d1-database-id>",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@later.dog"]
    }
  ],
  "services": [
    { "binding": "HOMES", "service": "laterdog-home", "entrypoint": "HomesApi" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
