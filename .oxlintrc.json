{
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "dist/**",
    "dist-electron/**",
    "dist-native/**",
    "dist-server/**",
    "electron/vendor/**",
    "release/**",
    "third_party/**",
    "electron/resources/**"
  ],
  "overrides": [
    {
      "files": [
        "electron/**/*.mjs"
      ],
      "env": {
        "node": true,
        "es2024": true
      },
      "rules": {
        "no-undef": "error"
      }
    }
  ]
}
