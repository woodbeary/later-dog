#!/bin/sh
set -e
if [ -n "$LATERDOG_SKIP_HOOKS" ]; then
  echo "pre-push: skipped (LATERDOG_SKIP_HOOKS is set)"
  exit 0
fi
case "$0" in
  */*) hook_dir=${0%/*} ;;
  *) hook_dir=. ;;
esac
if command -v node >/dev/null 2>&1; then
  exec node "$hook_dir/run-pre-push.mjs"
fi
. "$hook_dir/pre-push-checks"
