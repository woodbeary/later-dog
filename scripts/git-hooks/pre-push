#!/bin/sh
set -e
if [ -n "$LATERDOG_SKIP_HOOKS" ]; then
  echo "pre-push: skipped (LATERDOG_SKIP_HOOKS is set)"
  exit 0
fi
only_deletes=true
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) only_deletes=false ;;
  esac
done
if [ "$only_deletes" = true ]; then
  echo "pre-push: only deleting branches, nothing to check"
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: no comments, lint, typecheck, locale check (git push --no-verify to skip)"
node scripts/no-comments.ts --check
pnpm lint
pnpm typecheck
pnpm i18n:check
